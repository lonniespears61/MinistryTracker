<?xml version="1.0" encoding="utf-8" ?>
<!-- SettingsPage.xaml — Settings (modal) — 2026-01-22 -->

<ContentPage
    BackgroundColor="{StaticResource Settings.BgTint}"
    x:Class="MinistryTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="">
  
    
    <!-- Modal Settings is opened via PushModalAsync(new NavigationPage(SettingsPage)).
         So NavigationPage.TitleView is the correct header slot. -->
    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center"
              Padding="0,10,0,0"
              BackgroundColor="{StaticResource Settings.Base}">

            <!-- Left spacer (keeps title centered) -->
            <Grid />

            <Label Grid.Column="1"
                   Text="Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Done"
                    Padding="12,6"
                    CornerRadius="12"
                    BackgroundColor="{StaticResource Settings.Base}"
                    TextColor="White"
                    Clicked="OnDoneClicked" />
        </Grid>
    </NavigationPage.TitleView>

    <Grid BackgroundColor="{StaticResource Settings.BgTint}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- PRODUCTION: Near Me / Map Settings (placeholder for next session fields) -->
                <Border BackgroundColor="{StaticResource Settings.CardTint}"  
                 Stroke="{StaticResource Settings.BorderTint}"
                 StrokeThickness="1"
                 Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Near Me"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="Control how nearby calls are shown on the map."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <!-- Placeholder rows (we'll wire these up next session) -->
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">

                            <Label Text="Default radius"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Grid.Column="1"
                                   Text="(coming)"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                            <Label Grid.Row="1"
                                   Text="Auto-center on my location"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="(coming)"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ABOUT (full) -->
                <Border BackgroundColor="{StaticResource Settings.CardTint}"
                 Stroke="{StaticResource Settings.BorderTint}"
                 StrokeThickness="1"
                 Padding="14"
                 Margin="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                Offset="0,3"
                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <!-- Header -->
                        <Label Text="About"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <!-- App name / version -->
                        <Label Text="{Binding AppName}"
               FontSize="16"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="{Binding VersionDisplay}"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Label Text="{Binding Copyright}"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <!-- Short plain-language blurb -->
                        <Label Text="Ministry Tracker helps you keep call notes and return visits."
               FontSize="12"
               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Label Text="Data is stored locally on your device unless you export or share it."
               FontSize="12"
               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <!-- Legal wall behind Expander -->
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="Legal &amp; Privacy"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                    <Label Grid.Column="1"
                           Text="Tap to expand"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <toolkit:Expander.Content>
                                <Border BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#161616}"
                        Padding="12"
                        Margin="0,8,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Label Text="{Binding LegalDisclaimers}"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#334155, Dark=#D1D5DB}" />
                                </Border>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>

                    </VerticalStackLayout>
                </Border>


                <!-- DEV MODE TOGGLE -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="6">

                        <Label Text="Developer Mode"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsDeveloperMode}" />

                        <Label Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Shows local DB tools (health, seed, reset)."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />
                    </Grid>
                </Border>

                <!-- DEV TOOLS (hidden unless IsDeveloperMode) -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding IsDeveloperMode}">

                    <!-- Database Health -->
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <toolkit:Expander IsExpanded="{Binding HealthExpanded}">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Database Health"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                                    <Button Text="Show"
                                            Command="{Binding ShowDbHealthCommand}"
                                            Grid.Column="1">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding HealthExpanded}"
                                                         Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Text="Hide"
                                            Command="{Binding HideHealthCommand}"
                                            Grid.Column="1"
                                            IsVisible="False">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding HealthExpanded}"
                                                         Value="True">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </toolkit:Expander.Header>

                            <toolkit:Expander.Content>
                                <Editor Text="{Binding DbHealthText}"
                                        AutoSize="TextChanges"
                                        IsReadOnly="True"
                                        HeightRequest="220" />
                            </toolkit:Expander.Content>
                        </toolkit:Expander>
                    </Border>

                    <!-- Seed Demo Data -->
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Test Data"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Text="Inserts a small demo set (safe if empty)."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                            <Button Text="Re-seed Test Data"
                                    Command="{Binding SeedDemoDataCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Reset -->
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Beta Reset"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Text="Clears local data and rebuilds the DB."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                            <Button Text="Reset Local Database"
                                    BackgroundColor="#b00020"
                                    TextColor="White"
                                    Command="{Binding ResetAndSeedCommand}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="True"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
