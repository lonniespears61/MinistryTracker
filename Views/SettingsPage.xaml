<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="Settings">

    <!-- Page layout: Content + Busy Overlay -->
    <Grid>

        <!-- MAIN CONTENT -->
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="18">

                <!-- CARD: Database Health -->
                <Border Stroke="{DynamicResource Gray300}"
        StrokeThickness="1"
        BackgroundColor="White"
        Padding="12"
        Margin="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <toolkit:Expander IsExpanded="{Binding HealthExpanded}">
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="Database Health"
               FontAttributes="Bold"
               FontSize="18" />

                                <!-- Collapsed: show "Show DB Health" -->
                                <Button Text="Show DB Health"
                Command="{Binding ShowDbHealthCommand}"
                Grid.Column="1">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                         Binding="{Binding HealthExpanded}"
                         Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <!-- Expanded: show "Hide" -->
                                <Button Text="Hide"
                Command="{Binding HideHealthCommand}"
                Grid.Column="1"
                IsVisible="False">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                         Binding="{Binding HealthExpanded}"
                         Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <Editor Text="{Binding DbHealthText}"
              AutoSize="TextChanges"
              IsReadOnly="True"
              HeightRequest="220" />
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                </Border>

                <!-- CARD: Test Data -->
                <Border
                    Stroke="{DynamicResource Gray300}"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="12"
                    Margin="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Test Data"
                               FontAttributes="Bold"
                               FontSize="18"/>
                        <Label Text="Populate a small, deterministic set (safe to tap if empty)."
                               FontSize="12"/>

                        <Button Text="Re-seed Test Data"
                                Command="{Binding SeedDemoDataCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- CARD: Beta Reset -->
                <Border
                    Stroke="{DynamicResource Gray300}"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="12"
                    Margin="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Beta Reset"
                               FontAttributes="Bold"
                               FontSize="18"/>
                        <Label Text="Clear the local DB to a clean slate. App will recreate schema on next run."
                               FontSize="12"/>

                        <Button Text="Reset Local Database"
                                BackgroundColor="#b00020"
                                TextColor="White"
                                Command="{Binding ResetAndSeedCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BUSY OVERLAY (blocks taps while an operation runs) -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator
                IsRunning="True"
                WidthRequest="44"
                HeightRequest="44"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
