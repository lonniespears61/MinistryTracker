<?xml version="1.0" encoding="utf-8" ?>
<!-- SettingsPage.xaml — Settings (modal) -->

<ContentPage
    BackgroundColor="{StaticResource Settings.BgTint}"
    x:Class="MinistryTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="">

    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center"
              Padding="0,10,0,0"
              BackgroundColor="{StaticResource Settings.Base}">

            <Grid />

            <Label Grid.Column="1"
                   Text="Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Done"
                    Padding="12,6"
                    CornerRadius="12"
                    BackgroundColor="{StaticResource Settings.Base}"
                    TextColor="White"
                    Clicked="OnDoneClicked" />
        </Grid>
    </NavigationPage.TitleView>

    <Grid BackgroundColor="{StaticResource Settings.BgTint}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- NORMAL SERVICE DAYS -->
                <Border BackgroundColor="{StaticResource Settings.CardTint}"
                        Stroke="{StaticResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Normal Service Days"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="Choose the usual ministry period for each day. These defaults are used when scheduling new visits."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="10"
                              ColumnSpacing="12">

                            <Label Text="Sunday"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding ServicePeriodValues}"
                                    SelectedItem="{Binding ServiceDays.Sunday}"
                                    WidthRequest="160" />

                            <Label Grid.Row="1"
                                   Text="Monday"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Picker Grid.Row="1"
                                    Grid.Column="1"
                                    ItemsSource="{Binding ServicePeriodValues}"
                                    SelectedItem="{Binding ServiceDays.Monday}"
                                    WidthRequest="160" />

                            <Label Grid.Row="2"
                                   Text="Tuesday"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Picker Grid.Row="2"
                                    Grid.Column="1"
                                    ItemsSource="{Binding ServicePeriodValues}"
                                    SelectedItem="{Binding ServiceDays.Tuesday}"
                                    WidthRequest="160" />

                            <Label Grid.Row="3"
                                   Text="Wednesday"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Picker Grid.Row="3"
                                    Grid.Column="1"
                                    ItemsSource="{Binding ServicePeriodValues}"
                                    SelectedItem="{Binding ServiceDays.Wednesday}"
                                    WidthRequest="160" />

                            <Label Grid.Row="4"
                                   Text="Thursday"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Picker Grid.Row="4"
                                    Grid.Column="1"
                                    ItemsSource="{Binding ServicePeriodValues}"
                                    SelectedItem="{Binding ServiceDays.Thursday}"
                                    WidthRequest="160" />

                            <Label Grid.Row="5"
                                   Text="Friday"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Picker Grid.Row="5"
                                    Grid.Column="1"
                                    ItemsSource="{Binding ServicePeriodValues}"
                                    SelectedItem="{Binding ServiceDays.Friday}"
                                    WidthRequest="160" />

                            <Label Grid.Row="6"
                                   Text="Saturday"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Picker Grid.Row="6"
                                    Grid.Column="1"
                                    ItemsSource="{Binding ServicePeriodValues}"
                                    SelectedItem="{Binding ServiceDays.Saturday}"
                                    WidthRequest="160" />
                        </Grid>

                        <Button Text="Save Service Day Settings"
                                Command="{Binding SaveServiceDaySettingsCommand}"
                                BackgroundColor="{StaticResource Settings.Base}"
                                TextColor="White"
                                CornerRadius="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- PRODUCTION: Near Me / Map Settings -->
                <Border BackgroundColor="{StaticResource Settings.CardTint}"
                        Stroke="{StaticResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Near Me"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="Control how nearby calls are shown on the map."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">

                            <Label Text="Default radius"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Grid.Column="1"
                                   Text="(coming)"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                            <Label Grid.Row="1"
                                   Text="Auto-center on my location"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="(coming)"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ABOUT -->
                <Border BackgroundColor="{StaticResource Settings.CardTint}"
                        Stroke="{StaticResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14"
                        Margin="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="About"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="{Binding AppName}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="{Binding VersionDisplay}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Label Text="{Binding Copyright}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Label Text="Ministry Tracker helps you keep call notes and return visits."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Label Text="Data is stored locally on your device unless you export or share it."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="Legal &amp; Privacy"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                    <Label Grid.Column="1"
                                           Text="Tap to expand"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <toolkit:Expander.Content>
                                <Border BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#161616}"
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Label Text="{Binding LegalDisclaimers}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#334155, Dark=#D1D5DB}" />
                                </Border>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>
                    </VerticalStackLayout>
                </Border>

                <!-- DEV MODE TOGGLE -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="6">

                        <Label Text="Developer Mode"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsDeveloperMode}" />

                        <Label Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Shows local DB tools (health, seed, reset)."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />
                    </Grid>
                </Border>

                <!-- DEV TOOLS -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding IsDeveloperMode}">

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Database Schema"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="6">

                                <Label Text="Current Schema"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                <Label Grid.Column="1"
                                       Text="{Binding CurrentSchemaVersion}" />

                                <Label Grid.Row="1"
                                       Text="App Schema"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding AppSchemaVersion}" />

                                <Label Grid.Row="2"
                                       Text="Migration Needed"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding IsMigrationRequired}" />
                            </Grid>

                            <Button Text="Apply Database Update"
                                    Command="{Binding ApplyMigrationCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsMigrationRequired}"
                                                 Value="False">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <toolkit:Expander IsExpanded="{Binding HealthExpanded}">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Database Health"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                                    <Button Text="Show"
                                            Command="{Binding ShowDbHealthCommand}"
                                            Grid.Column="1">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding HealthExpanded}"
                                                         Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Text="Hide"
                                            Command="{Binding HideHealthCommand}"
                                            Grid.Column="1"
                                            IsVisible="False">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding HealthExpanded}"
                                                         Value="True">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </toolkit:Expander.Header>

                            <toolkit:Expander.Content>
                                <ScrollView HeightRequest="260">
                                    <Label Text="{Binding DbHealthText}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           Margin="0"
                                           Padding="0" />
                                </ScrollView>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Test Data"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Text="Delete local rows and rebuild test data using the current schema."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                            <Button Text="Delete &amp; Reseed Test Data"
                                    Command="{Binding DeleteAndReseedTestDataCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Reset DB (Schema + Data)"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Text="Delete the local database file, rebuild the schema, then seed test data."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                            <Button Text="Reset DB (Schema + Data)"
                                    BackgroundColor="#b00020"
                                    TextColor="White"
                                    Command="{Binding ResetDbSchemaAndDataCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Reset DB (Schema Only)"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Text="Delete the local database file and rebuild the schema without seeding test data."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                            <Button Text="Reset DB (Schema Only)"
                                    BackgroundColor="#7f1d1d"
                                    TextColor="White"
                                    Command="{Binding ResetDbSchemaOnlyCommand}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="True"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>