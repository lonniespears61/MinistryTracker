<?xml version="1.0" encoding="utf-8" ?>
<!-- SettingsPage.xaml â€” Settings (modal) -->

<ContentPage
    BackgroundColor="{DynamicResource Settings.BgTint}"
    x:Class="MinistryTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="">

    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center"
              Padding="0,10,0,0"
              BackgroundColor="{DynamicResource Settings.Base}">

            <Grid />

            <Label Grid.Column="1"
                   Text="Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Done"
                    Padding="12,6"
                    CornerRadius="12"
                    BackgroundColor="{DynamicResource Settings.Base}"
                    TextColor="White"
                    Clicked="OnDoneClicked" />
        </Grid>
    </NavigationPage.TitleView>

    <Grid BackgroundColor="{DynamicResource Settings.BgTint}">
        <ScrollView>
            <VerticalStackLayout x:Name="SettingsContent"
                                 Padding="16"
                                 Spacing="16">

                <!-- BETA FEEDBACK -->
                <Border BackgroundColor="{DynamicResource Settings.CardTint}"
                        Stroke="{DynamicResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding BetaTesterAgreementAccepted}"
                                  VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="Beta tester"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Text="Accept real-world beta terms and send feedback"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="Feedback"
                                Padding="12,6"
                                Clicked="OnFeedbackClicked" />
                    </Grid>
                </Border>

                <!-- SHARED COVERAGE -->
                <Border BackgroundColor="{DynamicResource Settings.CardTint}"
                        Stroke="{DynamicResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10"
                              VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding DataSharingAgreementAccepted}"
                                      VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="Shared coverage"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                <Label Text="Allow selected student/visit sharing when I choose to send it"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />
                            </VerticalStackLayout>
                        </Grid>

                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto"
                                      VerticalOptions="Center">
                                    <Label Text="Sharing agreement"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                    <Label Grid.Column="1"
                                           Text="Tap to read"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <toolkit:Expander.Content>
                                <Border BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#161616}"
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Label Text="{Binding DataSharingAgreementText}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#334155, Dark=#D1D5DB}" />
                                </Border>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>
                    </VerticalStackLayout>
                </Border>

                <!-- ENCRYPTED BACKUP -->
                <Border BackgroundColor="{DynamicResource Settings.CardTint}"
                        Stroke="{DynamicResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Encrypted Backup"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                            <Label Text="Create a protected copy and save it off-device"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Open"
                                Padding="12,6"
                                Clicked="OnEncryptedBackupClicked" />
                    </Grid>
                </Border>

                <!-- NORMAL SERVICE DAYS -->
                <Border BackgroundColor="{DynamicResource Settings.CardTint}"
                        Stroke="{DynamicResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Normal Service Days"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="Add only the days you normally use. These defaults are used when scheduling new visits."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <CollectionView x:Name="ServiceDaysList"
                                        ItemsSource="{Binding ActiveServiceDays}"
                                        EmptyView="No service days set. New visits will default to the next Saturday morning.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServiceDaySettingRowViewModel">
                                    <Grid ColumnDefinitions="*,*,Auto"
                                          ColumnSpacing="8"
                                          Padding="0,4">
                                        <Picker ItemsSource="{Binding DayValues}"
                                                SelectedItem="{Binding Day, Mode=TwoWay}" />

                                        <Picker Grid.Column="1"
                                                ItemsSource="{Binding PeriodValues}"
                                                SelectedItem="{Binding Period, Mode=TwoWay}" />

                                        <Button Grid.Column="2"
                                                Text="Remove"
                                                Padding="10,6"
                                                Clicked="OnRemoveServiceDayClicked" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="+ Add Service Day"
                                Command="{Binding AddServiceDayCommand}"
                                IsEnabled="{Binding CanAddServiceDay}"
                                CornerRadius="12" />

                        <Button Text="Save Service Day Settings"
                                Command="{Binding SaveServiceDaySettingsCommand}"
                                BackgroundColor="{DynamicResource Settings.Base}"
                                TextColor="White"
                                CornerRadius="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- ABOUT -->
                <Border BackgroundColor="{DynamicResource Settings.CardTint}"
                        Stroke="{DynamicResource Settings.BorderTint}"
                        StrokeThickness="1"
                        Padding="14"
                        Margin="0,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="About"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label Text="{Binding AppName}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />

                        <Label x:Name="VersionLabel"
                               Text="{Binding VersionDisplay}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVersionTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Text="{Binding Copyright}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Label Text="Ministry Tracker helps you keep call notes and return visits."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Label Text="Data is stored locally on your device unless you export or share it."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#9CA3AF}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button Text="Website"
                                    Clicked="OnWebsiteClicked"
                                    CornerRadius="12" />
                            <Button Grid.Column="1"
                                    Text="Privacy Policy"
                                    Clicked="OnPrivacyPolicyClicked"
                                    CornerRadius="12" />
                        </Grid>

                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="Legal &amp; Privacy"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                    <Label Grid.Column="1"
                                           Text="Tap to expand"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <toolkit:Expander.Content>
                                <Border BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#161616}"
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Label Text="{Binding LegalDisclaimers}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#334155, Dark=#D1D5DB}" />
                                </Border>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="True"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
