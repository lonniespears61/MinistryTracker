<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.MyCalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MinistryTracker.ViewModels"
    xmlns:models="clr-namespace:MinistryTracker.Models.DTOs"
    x:DataType="viewmodels:MyCalendarViewModel"
    Title="MyCalendar">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto"
              Padding="0,20,0,0"
              VerticalOptions="Center">
            <Label Text="My Calendar"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="Today"
                    Padding="12,6"
                    VerticalOptions="Center"
                    Command="{Binding GoToTodayCommand}"
                    IsVisible="{Binding ShowTodayButton}" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
          Padding="16,12"
          RowSpacing="10">

        <!-- ROW 0: Scheduling banner -->
        <Border Grid.Row="0"
                Padding="10"
                StrokeThickness="1"
                Stroke="#10B981"
                BackgroundColor="#ECFDF5"
                IsVisible="{Binding IsSchedulingMode}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Label Text="{Binding SchedulingBannerText}"
                   FontAttributes="Bold"
                   TextColor="#065F46" />
        </Border>

        <!-- ROW 1: Month header -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center">
            <Button Text="‹"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Command="{Binding PrevMonthCommand}" />

            <Label Grid.Column="1"
                   Text="{Binding MonthTitle}"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="›"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Command="{Binding NextMonthCommand}" />
        </Grid>

        <!-- ROW 2: Weekdays -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*,*,*,*,*"
              Padding="0,6"
              BackgroundColor="#F3F4F6">
            <Label Text="Sun" Grid.Column="0" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
            <Label Text="Mon" Grid.Column="1" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
            <Label Text="Tue" Grid.Column="2" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
            <Label Text="Wed" Grid.Column="3" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
            <Label Text="Thu" Grid.Column="4" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
            <Label Text="Fri" Grid.Column="5" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
            <Label Text="Sat" Grid.Column="6" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
        </Grid>

        <!-- ROW 3: Month grid -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding DayCells}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedDayCell, Mode=TwoWay}"
                        Margin="0,0,0,6">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:CalendarDayCellViewModel">
                    <Border Padding="6"
                            Margin="2"
                            StrokeThickness="1"
                            Stroke="{Binding BorderColor}"
                            BackgroundColor="#E5E7EB">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto"
                              ColumnDefinitions="*,Auto">

                            <Label Text="{Binding DayNumberText}"
                                   FontAttributes="{Binding DayNumberFontAttributes}"
                                   TextColor="{Binding DayNumberTextColor}"
                                   FontSize="14"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    WidthRequest="8"
                                    HeightRequest="8"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding DotColor}"
                                    IsVisible="{Binding HasVisits}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ROW 4: Selected day header + Add -->
        <Grid Grid.Row="4"
              ColumnDefinitions="*,Auto"
              VerticalOptions="Center">
            <Label Text="{Binding SelectedDayTitle}"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="{Binding SelectedDayActionText}"
                    Padding="12,6"
                    Command="{Binding AddVisitForSelectedDayCommand}"
                    IsEnabled="{Binding CanAddVisitForSelectedDay}" />
        </Grid>

        <!-- ROW 5: Additional reschedule details -->
        <Grid Grid.Row="5"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,*"
              RowSpacing="8"
              ColumnSpacing="12"
              IsVisible="{Binding IsRescheduleMode}">
            <Label Text="New time"
                   VerticalOptions="Center" />

            <TimePicker Grid.Column="1"
                        Time="{Binding RescheduleTime}" />

            <Label Grid.Row="1"
                   Text="Reason"
                   VerticalOptions="Start"
                   Margin="0,8,0,0" />

            <Editor Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding RescheduleReason}"
                    Placeholder="Why is this visit being rescheduled?"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="64" />
        </Grid>

        <!-- ROW 6: Agenda -->
        <CollectionView Grid.Row="6"
                        ItemsSource="{Binding SelectedDayVisits}"
                        SelectionMode="Single"
                        SelectionChanged="OnVisitSelectionChanged"
                        EmptyView="No visits scheduled for this day.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VisitWithStudent">
                    <Border Padding="12"
                            Margin="0,0,0,10"
                            StrokeThickness="1"
                            Stroke="{DynamicResource Gray200}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding StudentName}"
                                   FontSize="16"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding ScheduledDateTime, StringFormat='{0:ddd, MMM d • h:mm tt}'}"
                                   FontSize="12"
                                   Opacity="0.8" />

                            <Label Text="{Binding NotesPreview}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
