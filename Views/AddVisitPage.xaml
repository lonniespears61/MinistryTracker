<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.AddVisitPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:AddVisitViewModel"
    Title="Add Visit">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveVisitCommand}" Priority="0" />
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Visit Date" />
            <DatePicker x:Name="VisitDatePicker"
                        Date="{Binding VisitDate}"
                        DateSelected="OnVisitDateSelected" />

            <Label Text="Visit Time" />
            <TimePicker x:Name="VisitTimePicker"
                        Time="{Binding VisitTime}" />

            <Label Text="Method" />
            <Picker ItemsSource="{Binding ContactMethodValues}"
                    SelectedItem="{Binding Method}" />

            <Label Text="Meeting Address" />
            <Entry Text="{Binding MeetingAddress}"
                   Placeholder="Optional" />

            <Label Text="Notes" />
            <Editor Text="{Binding Notes}"
                    AutoSize="TextChanges"
                    Placeholder="Anything helpful to remember" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
