<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.AddVisitPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:AddVisitViewModel"
    Title="Add Visit">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save"
                     Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="{Binding StudentName, FallbackValue='Adding Visit'}"
                   FontSize="18"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Visit Date" />
                <DatePicker x:Name="VisitDatePicker"
                            Date="{Binding VisitDate, Mode=TwoWay}"
                            DateSelected="OnVisitDateSelected"
                            MinimumDate="2000-01-01"
                            MaximumDate="2100-12-31" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Visit Time" />
                <TimePicker x:Name="VisitTimePicker"
                            Time="{Binding VisitTime, Mode=TwoWay}"
                            IsEnabled="False" />
            </VerticalStackLayout>

            <Button Text="Schedule Visit"
                    Command="{Binding SaveCommand}"
                    HeightRequest="48"
                    CornerRadius="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>