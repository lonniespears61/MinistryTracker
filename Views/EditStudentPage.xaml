<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.EditStudentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:EditStudentViewModel"
    Title="Edit Student">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" Priority="0" />
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Name" />
            <Entry
                Text="{Binding Name}"
                Placeholder="Required" />

            <Label Text="First Contact Date" />
            <DatePicker Date="{Binding FirstContactDate}" />

            <Label Text="Initial Contact Type" />
            <Picker
                ItemsSource="{Binding InitialContactTypeValues}"
                SelectedItem="{Binding InitialContactType}" />

            <Label Text="Phone Number" />
            <Entry
                Text="{Binding PhoneNumber}"
                Placeholder="Optional"
                Keyboard="Telephone" />

            <Label Text="Preferred Contact Method" />
            <Picker
                ItemsSource="{Binding ContactMethodValues}"
                SelectedItem="{Binding PreferredContactMethod}" />

            <Label Text="Interest Level" />
            <Picker
                ItemsSource="{Binding InterestLevelValues}"
                SelectedItem="{Binding InterestLevel}" />

            <Label Text="Status" />
            <Picker
                ItemsSource="{Binding StudentStatusValues}"
                SelectedItem="{Binding Status}" />

            <Label Text="Notes" />
            <Editor
                Text="{Binding Notes}"
                AutoSize="TextChanges"
                Placeholder="Background, needs, personality, or other notes" />

            <Label
                Text="{Binding StatusMessage}"
                FontSize="12"
                TextColor="Green">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <BoxView HeightRequest="20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>