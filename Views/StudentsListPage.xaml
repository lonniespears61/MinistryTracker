<?xml version="1.0" encoding="utf-8"?>
<!-- StudentsListPage.xaml
     Notes:
     - Let CollectionView do the scrolling (no outer ScrollView).
     - ItemsSource binds to FilteredStudents (type: Student).
     - The item template is strongly typed to models:Student for compile-time checks.
-->

<ContentPage
    x:Class="MinistryTracker.Views.StudentsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels;assembly=MinistryTracker"
    xmlns:models="clr-namespace:MinistryTracker.Models;assembly=MinistryTracker"
    x:DataType="vm:StudentsListViewModel">

    <!-- Two rows: search (Auto) + list (*) -->
    <Grid RowDefinitions="Auto,*">

        <!-- Search (row 0) -->
        <SearchBar
            Grid.Row="0"
            Placeholder="Search students..."
            Text="{Binding SearchText}"
            Margin="20,20,20,10" />

        <!-- Students list (row 1) — CollectionView provides its own scrolling -->
        <CollectionView
            Grid.Row="1"
            x:Name="StudentsCollection"
            ItemsSource="{Binding FilteredStudents}"
            SelectionMode="Single"
            SelectionChanged="OnStudentSelectionChanged"
            ItemSizingStrategy="MeasureAllItems"
            VerticalOptions="FillAndExpand"
            Margin="20,0,20,20">

            <!-- Empty state -->
            <CollectionView.EmptyView>
                <Grid Padding="24" RowDefinitions="Auto,Auto">
                    <Label Text="No students yet"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Grid.Row="1"
                           Text="Tap + to add your first student."
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </Grid>
            </CollectionView.EmptyView>

            <!-- Item template: strongly typed to Student -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Student">
                    <Border Stroke="LightGray"
                            StrokeThickness="1"
                            BackgroundColor="WhiteSmoke"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">

                            <!-- Name (bind directly to Student.Name) -->
                            <Label Text="{Binding Name,
                                                  FallbackValue='(no Name property)',
                                                  TargetNullValue='(name is null)'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <!-- First contact date -->
                            <Label Text="{Binding FirstContactDate,
                                                  StringFormat='First contact: {0:d}',
                                                  FallbackValue='(no FirstContactDate property)'}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />

                            <!-- Study location type -->
                            <Label Text="{Binding StudyLocationType,
                                                  FallbackValue='(no StudyLocationType property)',
                                                  TargetNullValue='(not set)'}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=DarkGreen, Dark=LightGreen}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Floating + button (overlaid) -->
        <Button
            Text="+"
            FontSize="24"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="30"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="20"
            BackgroundColor="ForestGreen"
            TextColor="White"
            Clicked="OnAddStudentClicked"
            ZIndex="10" />
    </Grid>
</ContentPage>
