<!-- Views/StudentsListPage.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.StudentsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    xmlns:models="clr-namespace:MinistryTracker.Models"
    Title="Students">

    <!-- Optional: Add button in the toolbar -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Priority="0" Order="Primary" Clicked="OnAddStudentClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Search / Header row (optional) -->
        <Label Text="Students" FontSize="24" FontAttributes="Bold" />

        <CollectionView Grid.Row="1"
                        x:Name="StudentsCollection"
                        ItemsSource="{Binding Students}"
                        SelectionMode="Single"
                        SelectionChanged="OnStudentSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:StudentViewModel">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <!-- Edit -->
                            <SwipeItem Text="Edit"
                                       BackgroundColor="#2E7D32"
                                       CommandParameter="{Binding Model}"
                                       Invoked="OnEditSwipeInvoked" />
                            <!-- Add Visit -->
                            <SwipeItem Text="Add Visit"
                                       BackgroundColor="#1565C0"
                                       CommandParameter="{Binding Model}"
                                       Invoked="OnAddVisitSwipeInvoked" />
                        </SwipeView.RightItems>

                        <!-- Row content -->
                        <Grid Padding="12" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding LastVisitSummary}" FontSize="12" Opacity="0.7" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Source="chevron_right.png" VerticalOptions="Center" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
