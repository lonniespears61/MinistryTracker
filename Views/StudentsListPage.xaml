<?xml version="1.0" encoding="utf-8" ?>
<!-- StudentsListPage.xaml — Students list (Shell tab) — 2026-02-01 -->

<ContentPage
    x:Class="MinistryTracker.Views.StudentsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="viewmodels:StudentsListViewModel"
    Title="Students"
    BackgroundColor="{StaticResource Students.BgTint}">

    <Shell.TitleView>
        <Grid VerticalOptions="Center"
              Padding="0,20,0,0"
              BackgroundColor="{StaticResource Students.Base}">
            <Label Text="Student List"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16,12">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,6,0,10">

            <Label Text="Students"
                   FontSize="24"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E6EEF9}" />

            <Button Text="Add"
                    Grid.Column="1"
                    Clicked="OnAddStudentClicked"
                    CornerRadius="12"
                    BackgroundColor="{StaticResource Students.Base}"
                    TextColor="White" />
        </Grid>

        <SearchBar Grid.Row="1"
                   Placeholder="Search students"
                   Text="{Binding SearchText}"
                   Margin="0,0,0,10" />

        <CollectionView x:Name="StudentsCollection"
                        Grid.Row="2"
                        ItemsSource="{Binding FilteredStudents}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:StudentViewModel">

                    <SwipeView>

                        <!-- Swipe RIGHT (left-to-right) executes LEFT items -->
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Edit Student"
                                           BackgroundColor="#3B82F6"
                                           Invoked="OnEditSwipeInvoked"
                                           CommandParameter="{Binding Model}" />
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <!-- Swipe LEFT (right-to-left) executes RIGHT items -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Schedule Visit"
                                           BackgroundColor="#10B981"
                                           Invoked="OnScheduleVisitSwipeInvoked"
                                           CommandParameter="{Binding Model}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border BackgroundColor="{StaticResource Students.CardTint}"
                                Stroke="{StaticResource Students.BorderTint}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Margin="0,0,0,10">

                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsAlternate}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource Students.BgTint}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid Padding="12,10"
                                  ColumnDefinitions="Auto,*,Auto">

                                <Border Padding="8"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        VerticalOptions="Center"
                                        BackgroundColor="#EEF2FF"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <Label Text="{Binding Initials}"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E6EEF9}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     Padding="12,0">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E6EEF9}" />

                                    <Label Text="{Binding SubTitle}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9AA6B2}" />
                                </VerticalStackLayout>

                                <Image Grid.Column="2"
                                       Source="chevron_right.png"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center"
                                       Opacity="0.5" />

                            </Grid>
                        </Border>

                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
