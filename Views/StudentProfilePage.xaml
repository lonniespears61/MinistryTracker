<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.StudentProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:StudentProfileViewModel"
    Title="">

    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="Auto,*"
              VerticalOptions="Center"
              Padding="0,6,0,0">

            <ImageButton
                Source="icon_home.png"
                WidthRequest="28"
                HeightRequest="28"
                BackgroundColor="Transparent"
                Clicked="OnHomeClicked" />

            <Label Grid.Column="1"
                   Text="Student"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="12,0,0,0" />
        </Grid>
    </NavigationPage.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- HEADER -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                <Border WidthRequest="60" HeightRequest="60"
                        BackgroundColor="#E8F0FE"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>

                    <Label Text="{Binding Initials}"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="#1A73E8" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="4">

                    <Label Text="{Binding Name}"
                           FontSize="24"
                           FontAttributes="Bold" />

                    <Label Text="{Binding SubTitle}"
                           FontSize="14"
                           Opacity="0.75" />

                    <HorizontalStackLayout Spacing="8">

                        <!-- STATUS -->
                        <Border Padding="8,3"
                                BackgroundColor="{Binding StatusColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label Text="{Binding StatusLabel}"
                                   FontSize="12"
                                   TextColor="White" />
                        </Border>

                        <!-- INTEREST -->
                        <Border Padding="8,3"
                                BackgroundColor="{Binding InterestColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label Text="{Binding InterestLabel}"
                                   FontSize="12"
                                   TextColor="Black" />
                        </Border>

                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <!-- DETAILS -->
            <Border BackgroundColor="White"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#333}"
                    StrokeThickness="1"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label Text="Details"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label Text="{Binding FirstContactFormatted}" />

                    <!-- PHONE -->
                    <Label Text="{Binding PhoneNumber, StringFormat='Phone: {0}'}"
                           IsVisible="{Binding PhoneNumber}" />

                    <!-- NOTES -->
                    <Label Text="{Binding Notes}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding HasNotes}" />

                </VerticalStackLayout>
            </Border>

            <!-- ACTION -->
            <Button Text="Edit Student"
                    Clicked="OnEditStudentClicked"
                    BackgroundColor="#1A73E8"
                    TextColor="White"
                    CornerRadius="12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>