<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MinistryTracker.ViewModels"
    xmlns:dto="clr-namespace:MinistryTracker.Models.DTOs"
    x:DataType="viewmodels:DashboardViewModel">

    <!-- TitleView only shows if this page is inside a NavigationPage -->
    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="Auto,*"
              VerticalOptions="Center"
              Padding="0,6,0,0">

            <Label Text="Ministry Tracker"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"
                   VerticalOptions="Center"
                   HorizontalOptions="Start" />

        </Grid>
    </NavigationPage.TitleView>

    <!-- Root layout -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ROW 0 — TOP ACTION ICONS -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="12,6">

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">

                <ImageButton Source="icon_about.png"
                             WidthRequest="36"
                             HeightRequest="36"
                             BackgroundColor="Transparent"
                             Clicked="OnAboutClicked"
                             SemanticProperties.Description="About" />

                <ImageButton Source="icon_settings.png"
                             WidthRequest="36"
                             HeightRequest="36"
                             BackgroundColor="Transparent"
                             Clicked="OnSettingsClicked"
                             SemanticProperties.Description="Settings" />

            </HorizontalStackLayout>
        </Grid>

        <!-- ROW 1 — DASHBOARD HEADING -->
        <Label Grid.Row="1"
               Text="Dashboard"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="DarkBlue"
               HorizontalTextAlignment="Center"
               Margin="0,4,0,0" />

        <!-- ROW 2 — SCROLLABLE CONTENT -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Active Students Card -->
                <Border BackgroundColor="PaleTurquoise"
                        StrokeThickness="1"
                        Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnActiveStudentsTapped" />
                    </Border.GestureRecognizers>

                    <Border.Shadow>
                        <Shadow Brush="Gray"
                                Offset="2,2"
                                Radius="4" />
                    </Border.Shadow>

                    <VerticalStackLayout>
                        <Label Text="Active Students"
                               FontAttributes="Bold"
                               FontSize="18" />
                        <Label Text="{Binding ActiveStudentsCount}"
                               FontSize="24"
                               TextColor="DarkGreen" />
                    </VerticalStackLayout>
                </Border>

                <!-- Calls Next 7 Days -->
                <Border Stroke="{AppThemeBinding Light=#e5e5e5, Dark=#333}"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e1e1e}"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">

                            <Label Text="Calls Next 7 Days"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <HorizontalStackLayout Grid.Row="1"
                                                   Spacing="12"
                                                   Margin="0,6,0,0">

                                <Border Padding="8,2" BackgroundColor="#2D7FF9">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ThisWeekScheduledCount, StringFormat='Scheduled: {0}'}"
                                           TextColor="White" />
                                </Border>

                                <Border Padding="8,2" BackgroundColor="#2E8B57">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ThisWeekCompletedCount, StringFormat='Completed: {0}'}"
                                           TextColor="White" />
                                </Border>

                                <Border Padding="8,2" BackgroundColor="#C94F4F">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ThisWeekCanceledCount, StringFormat='Canceled: {0}'}"
                                           TextColor="White" />
                                </Border>

                            </HorizontalStackLayout>
                        </Grid>

                        <CollectionView ItemsSource="{Binding ThisWeekUpcoming}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No more scheduled calls this week."
                                       TextColor="Gray" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:VisitWithStudent">
                                    <Grid ColumnDefinitions="Auto,*" Padding="0,6">
                                        <Label Text="{Binding Visit.ScheduledDateTime, StringFormat='{0:ddd h:mm tt}'}"
                                               FontAttributes="Bold"
                                               WidthRequest="110" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Student.Name}"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#444, Dark=#ccc}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
