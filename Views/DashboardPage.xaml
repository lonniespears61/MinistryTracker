<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MinistryTracker.ViewModels"
    xmlns:dto="clr-namespace:MinistryTracker.Models.DTOs"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Dashboard">

    <!-- Shell header (works with Shell + TabBar) -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center"
              Padding="0,20,0,0">

            <Label Text="Ministry Tracker"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"
                   VerticalOptions="Center"
                   HorizontalOptions="Start" />

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">

                <ImageButton Source="icon_settings.png"
                             WidthRequest="36"
                             HeightRequest="36"
                             BackgroundColor="Transparent"
                             Clicked="OnSettingsClicked"
                             SemanticProperties.Description="Settings" />

                <ImageButton Source="icon_about.png"
                             WidthRequest="36"
                             HeightRequest="36"
                             BackgroundColor="Transparent"
                             Clicked="OnAboutClicked"
                             SemanticProperties.Description="About" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!-- Page title -->
        <Label Grid.Row="0"
               Text="Dashboard"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="DarkBlue"
               HorizontalTextAlignment="Center"
               Margin="0,8,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- TODAY / UPCOMING (keep existing binding to avoid breaking build)
                     Later: swap ItemsSource to Today list when VM is ready -->
                <Border Stroke="{AppThemeBinding Light=#e5e5e5, Dark=#333}"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e1e1e}"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Upcoming"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <CollectionView ItemsSource="{Binding ThisWeekUpcoming}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No calls planned for today."
                                       TextColor="Gray" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:VisitWithStudent">
                                    <Grid ColumnDefinitions="Auto,*"
                                          Padding="0,6">
                                        <Label Text="{Binding ScheduledDateTime, StringFormat='{0:h:mm tt}'}"
                                               FontAttributes="Bold"
                                               WidthRequest="90" />
                                        <Label Grid.Column="1"
                                               Text="{Binding StudentName}"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#444, Dark=#ccc}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="(Use the My Calendar tab for full schedule.)"
                               FontSize="12"
                               TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <!-- WHO SHOULD I CHECK ON (stub card for now, no new bindings yet) -->
                <Border Stroke="{AppThemeBinding Light=#e5e5e5, Dark=#333}"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e1e1e}"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Let's Check On"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="(Coming next: suggestions based on time since last visit.)"
                               FontSize="12"
                               TextColor="Gray" />

                        <!-- Optional: later replace with a small list -->
                    </VerticalStackLayout>
                </Border>

                <!-- QUICK ACTION: I JUST MET SOMEONE -->
                <Border BackgroundColor="PaleTurquoise"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="New Call?"
                               FontAttributes="Bold"
                               FontSize="18" />

                        <Label Text="Add notes now. You can schedule the first return visit if you arranged one."
                               FontSize="12"
                               TextColor="Black" />

                        <Button Text="Add New Call"
                                Clicked="OnAddNewCallClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- STANDALONE UTILITY: FIND NEARBY CALLS -->
                <Border Stroke="{AppThemeBinding Light=#e5e5e5, Dark=#333}"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e1e1e}"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Find Nearby Calls"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="Use your current location to view nearby calls on the map."
                               FontSize="12"
                               TextColor="Gray" />

                        <Button Text="Open Map"
                                Clicked="OnOpenMapClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- OPTIONAL: Calls count (keep existing VM binding) -->
                <Border Stroke="{AppThemeBinding Light=#e5e5e5, Dark=#333}"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e1e1e}"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
