<?xml version="1.0" encoding="utf-8" ?>
<!--
DashboardPage.xaml

PURPOSE
- Main decision-first dashboard for daily ministry use.
- Surfaces only what needs attention now.

DESIGN RULES
- No counters or reporting cards
- No placeholder or empty sections
- "Get Started" = immediate actions
- "Today" = scheduled visits for today
- "Follow Up" = missed recent visits needing action
- Sections appear only when they have data
-->
<ContentPage
    x:Class="MinistryTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MinistryTracker.ViewModels"
    xmlns:dto="clr-namespace:MinistryTracker.Models.DTOs"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="{StaticResource Dashboard.BgTint}">

    <Shell.TitleView>
        <Grid
            ColumnDefinitions="*,Auto"
            Padding="0,20,0,0"
            VerticalOptions="Center"
            BackgroundColor="{StaticResource Dashboard.Base}">

            <Label
                Text="MyServiceNotes"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="8"
                HorizontalOptions="End"
                VerticalOptions="Center">

                <ImageButton
                    Source="icon_settings.png"
                    WidthRequest="36"
                    HeightRequest="36"
                    BackgroundColor="Transparent"
                    Clicked="OnSettingsClicked"
                    SemanticProperties.Description="Settings" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- GET STARTED -->
            <Border
                BackgroundColor="{StaticResource Dashboard.CardTint}"
                Stroke="{StaticResource Dashboard.BorderTint}"
                StrokeThickness="1"
                Padding="0"
                Margin="0,2">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                        Offset="0,3"
                        Radius="10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border
                        BackgroundColor="{StaticResource Dashboard.Base}"
                        Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18,18,0,0" />
                        </Border.StrokeShape>

                        <Label
                            Text="Get Started"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />
                    </Border>

                    <Grid
                        Padding="16"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            Text="Add New Return Visit"
                            Clicked="OnAddNewCallClicked"
                            CornerRadius="14"
                            HeightRequest="54"
                            BackgroundColor="{StaticResource Dashboard.Base}"
                            TextColor="White" />

                        <Button
                            Grid.Column="1"
                            Text="Return Visits Near Me"
                            Clicked="OnOpenMapClicked"
                            CornerRadius="14"
                            HeightRequest="54"
                            BackgroundColor="#4D9B4A"
                            TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- TODAY -->
            <Border
                IsVisible="{Binding HasTodayVisits}"
                BackgroundColor="{StaticResource Dashboard.CardTint}"
                Stroke="{StaticResource Dashboard.BorderTint}"
                StrokeThickness="1"
                Padding="0"
                Margin="0,2">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                        Offset="0,3"
                        Radius="10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border
                        BackgroundColor="#6FAE5D"
                        Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18,18,0,0" />
                        </Border.StrokeShape>

                        <Label
                            Text="Today"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />
                    </Border>

                    <CollectionView
                        ItemsSource="{Binding TodayVisits}"
                        SelectionMode="None"
                        Margin="0"
                        BackgroundColor="Transparent">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:VisitWithStudent">
                                <Grid
                                    Padding="16,14"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            Text="{Binding StudentName}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                                        <Label
                                            Text="{Binding NotesPreview}"
                                            FontSize="13"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding ScheduledDateTime, StringFormat='{0:h:mm tt}'}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- FOLLOW UP -->
            <Border
                IsVisible="{Binding HasMissedRecently}"
                BackgroundColor="{StaticResource Dashboard.CardTint}"
                Stroke="{StaticResource Dashboard.BorderTint}"
                StrokeThickness="1"
                Padding="0"
                Margin="0,2">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                        Offset="0,3"
                        Radius="10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border
                        BackgroundColor="#E3A033"
                        Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18,18,0,0" />
                        </Border.StrokeShape>

                        <Label
                            Text="Follow Up"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />
                    </Border>

                    <CollectionView
                        ItemsSource="{Binding MissedRecently}"
                        SelectionMode="None"
                        Margin="0"
                        BackgroundColor="Transparent">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:VisitWithStudent">
                                <Border
                                    Margin="16,12,16,0"
                                    Padding="14"
                                    BackgroundColor="#F8EFE4"
                                    Stroke="#E3A033"
                                    StrokeThickness="1.5">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Label
                                                Text="{Binding StudentName}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding ScheduledDateTime, StringFormat='{0:ddd h:mm tt}'}"
                                                FontSize="14"
                                                VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        </Grid>

                                        <Label
                                            Text="{Binding NotesPreview}"
                                            FontSize="13"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="12" Opacity="0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>