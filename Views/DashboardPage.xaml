<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MinistryTracker.ViewModels"
    xmlns:dto="clr-namespace:MinistryTracker.Models.DTOs"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Dashboard">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center"
              Padding="0,20,0,0">

            <Label Text="Ministry Tracker"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"
                   VerticalOptions="Center"
                   HorizontalOptions="Start" />

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                <ImageButton Source="icon_settings.png"
               WidthRequest="36"
               HeightRequest="36"
               BackgroundColor="Transparent"
               Clicked="OnSettingsClicked"
               SemanticProperties.Description="Settings" />

                <ImageButton Source="icon_about.png"
                             WidthRequest="36"
                             HeightRequest="36"
                             BackgroundColor="Transparent"
                             Clicked="OnAboutClicked"
                             SemanticProperties.Description="About" />

            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="Dashboard"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="DarkBlue"
               HorizontalTextAlignment="Center"
               Margin="0,8,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Border BackgroundColor="PaleTurquoise"
                        StrokeThickness="1"
                        Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <!-- <TapGestureRecognizer Tapped="OnActiveStudentsTapped" /> -->
                    </Border.GestureRecognizers>

                    <Border.Shadow>
                        <Shadow Brush="Gray"
                                Offset="2,2"
                                Radius="4" />
                    </Border.Shadow>

                    <VerticalStackLayout>
                        <Label Text="Active Students"
                               FontAttributes="Bold"
                               FontSize="18" />
                        <Label Text="{Binding ActiveStudentsCount}"
                               FontSize="24"
                               TextColor="DarkGreen" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="{AppThemeBinding Light=#e5e5e5, Dark=#333}"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e1e1e}"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">

                            <Label Text="Calls Next 7 Days"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <!-- Row of 3 status pills (wraps on small screens) -->
                            <FlexLayout Grid.Row="1"
                                        Direction="Row"
                                        Wrap="Wrap"
                                        Margin="0,6,0,0">

                                <Border Padding="8,2"
                                        Margin="0,0,12,10"
                                        BackgroundColor="#2D7FF9">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ThisWeekScheduledCount, StringFormat='Scheduled: {0}'}"
                                           TextColor="White" />
                                </Border>

                                <Border Padding="8,2"
                                        Margin="0,0,12,10"
                                        BackgroundColor="#2E8B57">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ThisWeekCompletedCount, StringFormat='Completed: {0}'}"
                                           TextColor="White" />
                                </Border>

                                <Border Padding="8,2"
                                        Margin="0,0,12,10"
                                        BackgroundColor="#C94F4F">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ThisWeekCanceledCount, StringFormat='Canceled: {0}'}"
                                           TextColor="White" />
                                </Border>

                            </FlexLayout>
                        </Grid>

                        <CollectionView ItemsSource="{Binding ThisWeekUpcoming}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No more scheduled calls this week."
                                       TextColor="Gray" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:VisitWithStudent">
                                    <Grid ColumnDefinitions="Auto,*" Padding="0,6">
                                        <Label Text="{Binding ScheduledDateTime, StringFormat='{0:ddd h:mm tt}'}"
                                               FontAttributes="Bold"
                                               WidthRequest="110" />
                                        <Label Grid.Column="1"
                                               Text="{Binding StudentName}"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#444, Dark=#ccc}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Test Map"
                                Clicked="OnTestMapClicked" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
