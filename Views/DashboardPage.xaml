<?xml version="1.0" encoding="utf-8" ?>
<!-- DashboardPage.xaml — Publisher Today dashboard — 2026-01-22 -->

<ContentPage
    x:Class="MinistryTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MinistryTracker.ViewModels"
    xmlns:dto="clr-namespace:MinistryTracker.Models.DTOs"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="{StaticResource Dashboard.BgTint}">

    <!-- Shell header (works with Shell + TabBar) -->
    <Shell.TitleView>
        <Grid
            ColumnDefinitions="*,Auto"
            Padding="0,20,0,0"
            VerticalOptions="Center"
            BackgroundColor="{StaticResource Dashboard.Base}">

            <Label
                Text="Ministry Tracker"
                FontSize="20"
                FontAttributes="Bold"
                BackgroundColor="Transparent"
                TextColor="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="8"
                HorizontalOptions="End"
                VerticalOptions="Center">

                <ImageButton
                    Source="icon_settings.png"
                    WidthRequest="36"
                    HeightRequest="36"
                    BackgroundColor="Transparent"
                    Clicked="OnSettingsClicked"
                    SemanticProperties.Description="Settings" />

            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!-- Page title (you can remove this entirely if the Shell header is enough) -->
        <Label
            Grid.Row="0"
            Text="Dashboard"
            FontSize="22"
            FontAttributes="Bold"
            TextColor="Transparent"
            HorizontalTextAlignment="Center"
            Margin="0,10,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- UPCOMING -->
                <Border
                    BackgroundColor="{StaticResource Dashboard.CardTint}"
                    Stroke="{StaticResource Dashboard.BorderTint}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,2">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                            Offset="0,3"
                            Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Upcoming"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Dashboard.Base}" />

                        <CollectionView
                            ItemsSource="{Binding ThisWeekUpcoming}"
                            SelectionMode="None">

                            <CollectionView.EmptyView>
                                <Label
                                    Text="No calls planned for today."
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:VisitWithStudent">
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="12"
                                        Padding="0,6">

                                        <Label
                                            Text="{Binding ScheduledDateTime, StringFormat='{0:h:mm tt}'}"
                                            FontAttributes="Bold"
                                            WidthRequest="90"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding StudentName}"
                                            LineBreakMode="TailTruncation"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label
                            Text="Use the My Calendar tab for the full schedule."
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- CHECK ON -->
                <Border
                    BackgroundColor="{StaticResource Dashboard.CardTint}"
                    Stroke="{StaticResource Dashboard.BorderTint}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,2">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                            Offset="0,3"
                            Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Let’s Check On"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                        <Label
                            Text="Next session: suggestions based on time since last visit."
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- NEW CALL (primary action) -->
                <Border
                    BackgroundColor="{StaticResource Dashboard.CardTint}"
                    Stroke="{StaticResource Dashboard.BorderTint}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,2"
                    MinimumHeightRequest="84">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                            Offset="0,3"
                            Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Button
                            Text="Add New Call"
                            Clicked="OnAddNewCallClicked"
                            CornerRadius="12"
                            BackgroundColor="{StaticResource Dashboard.Base}"
                            TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- NEAR ME (less crowded) -->
                <Border
                    BackgroundColor="{StaticResource Dashboard.CardTint}"
                    Stroke="{StaticResource Dashboard.BorderTint}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,2"
                    MinimumHeightRequest="84">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light=#25000000, Dark=#66000000}"
                            Offset="0,3"
                            Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">

                                              
                        <Button
                            Text="Find Nearby Calls"
                            Clicked="OnOpenMapClicked"
                            CornerRadius="12"
                            BackgroundColor="{StaticResource Dashboard.Base}"
                            TextColor="White"
                            Margin="0,6,0,0" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
