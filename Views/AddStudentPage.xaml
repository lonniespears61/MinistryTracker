<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.AddStudentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="vm:AddStudentViewModel"
    Title="Add Student">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveStudentCommand}" Priority="0" />
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- FIRST PASS / CORE -->
            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Required" />

            <Label Text="Initial Contact Type" />
            <Picker ItemsSource="{Binding InitialContactTypeValues}"
                    SelectedItem="{Binding InitialContactType}" />

            <Label Text="First Contact Date" />
            <DatePicker Date="{Binding FirstContactDate}" />

            <Label Text="Phone Number" />
            <Entry Text="{Binding PhoneNumber}"
                   Keyboard="Telephone"
                   Placeholder="Optional" />

            <Label Text="Address" />
            <Entry Text="{Binding Address}"
                   Placeholder="Street, rural directions, or notes"
                   ClearButtonVisibility="WhileEditing" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Use Current Location"
                        Command="{Binding UseCurrentLocationCommand}" />
                <ActivityIndicator IsRunning="{Binding IsLocating}"
                                   IsVisible="{Binding IsLocating}" />
            </HorizontalStackLayout>

            <!-- OPTIONAL DETAILS -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="More Details"
                           FontAttributes="Bold"
                           FontSize="16" />
                </toolkit:Expander.Header>

                <VerticalStackLayout Spacing="12" Padding="0,10,0,0">

                    <Label Text="Default Contact Method" />
                    <Picker ItemsSource="{Binding ContactMethodValues}"
                            SelectedItem="{Binding DefaultContactMethod}" />

                    <Label Text="Interest Level" />
                    <Picker ItemsSource="{Binding InterestLevelValues}"
                            SelectedItem="{Binding InterestLevel}" />

                    <Label Text="Status" />
                    <Picker ItemsSource="{Binding StudentStatusValues}"
                            SelectedItem="{Binding Status}" />

                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding IsDoNotCall}" />
                        <Label Text="Do Not Call"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="Notes" />
                    <Editor Text="{Binding Notes}"
                            AutoSize="TextChanges"
                            Placeholder="Anything helpful to remember" />

                </VerticalStackLayout>
            </toolkit:Expander>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>