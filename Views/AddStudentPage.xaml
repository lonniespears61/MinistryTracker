<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MinistryTracker.Views.AddStudentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels;assembly=MinistryTracker"
    x:DataType="vm:AddStudentViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Enter name" />

            <Label Text="Initial Call Type" Margin="0,10,0,0" />
            <Picker Title="Select call type"
                    ItemsSource="{Binding CallTypeValues}"
                    SelectedItem="{Binding CallType}" />

            <Label Text="First Contact Date" Margin="0,10,0,0" />
            <DatePicker Date="{Binding FirstContactDate}" />

            <Label Text="Preferred Language" Margin="0,10,0,0" />
            <Entry Text="{Binding PreferredLanguage}" Placeholder="e.g., English" />

            <Button Text="Save" Margin="0,20,0,0" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
