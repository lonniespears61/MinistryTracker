<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MinistryTracker.Views.AddStudentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MinistryTracker.ViewModels"
    x:DataType="vm:AddStudentViewModel">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Enter name" />

            <Label Text="Initial Call Type" Margin="0,10,0,0" />
            <Picker Title="Select call type"
                    ItemsSource="{Binding CallTypeValues}"
                    SelectedItem="{Binding CallType}" />

            <Label Text="First Contact Date" Margin="0,10,0,0" />
            <DatePicker Date="{Binding FirstContactDate}" />

            <Label Text="Preferred Language" Margin="0,10,0,0" />
            <Entry Text="{Binding PreferredLanguage}" Placeholder="e.g., English" />

            <Label Text="Notes" Margin="0,10,0,0" />
            <Editor Text="{Binding Notes}"
                 Placeholder="Free text notes (use this for descriptions/context)"
                 AutoSize="TextChanges"
                 HeightRequest="100" />

            <Button Text="Use current location"
                    Command="{Binding UseCurrentLocationCommand}" />

            <ActivityIndicator IsRunning="{Binding IsLocating}"
                               IsVisible="{Binding IsLocating}" />

            <!-- Show status text when not empty -->
            <Label FontSize="12"
                   TextColor="Green"
                   Text="{Binding LocationStatus}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding LocationStatus}"
                                 Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding LocationStatus}"
                                 Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button Text="Save"
                    Margin="0,20,0,0"
                    Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
