<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')" />

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>MinistryTracker</RootNamespace>
		<UseMaui>true</UseMaui>
		<EnablePreviewMsBuildFeatures>true</EnablePreviewMsBuildFeatures>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>MinistryTracker</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.ministrytoolworks.tracker</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<AndroidManifestPlaceholders Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">GOOGLE_MAPS_API_KEY=$(GoogleMapsApiKey)</AndroidManifestPlaceholders>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MINISTRYTOOLWORKS_KEYSTORE_PATH)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>$(MINISTRYTOOLWORKS_KEY_ALIAS)</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>$(MINISTRYTOOLWORKS_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
		<AndroidSigningKeyPass>$(MINISTRYTOOLWORKS_KEY_PASSWORD)</AndroidSigningKeyPass>
	</PropertyGroup>

	<Target Name="ValidateAndroidReleaseConfiguration"
	        BeforeTargets="PrepareForBuild"
	        Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Error Condition="'$(GoogleMapsApiKey)' == ''"
		       Text="Android Release requires GoogleMapsApiKey. Set it in the ignored Directory.Build.local.props file or provide it as an MSBuild property." />
		<Error Condition="'$(MINISTRYTOOLWORKS_KEYSTORE_PATH)' == ''"
		       Text="Android Release requires MINISTRYTOOLWORKS_KEYSTORE_PATH." />
		<Error Condition="!Exists('$(MINISTRYTOOLWORKS_KEYSTORE_PATH)')"
		       Text="Android Release keystore was not found at '$(MINISTRYTOOLWORKS_KEYSTORE_PATH)'." />
		<Error Condition="'$(MINISTRYTOOLWORKS_KEY_ALIAS)' == ''"
		       Text="Android Release requires MINISTRYTOOLWORKS_KEY_ALIAS." />
		<Error Condition="'$(MINISTRYTOOLWORKS_KEYSTORE_PASSWORD)' == ''"
		       Text="Android Release requires MINISTRYTOOLWORKS_KEYSTORE_PASSWORD." />
		<Error Condition="'$(MINISTRYTOOLWORKS_KEY_PASSWORD)' == ''"
		       Text="Android Release requires MINISTRYTOOLWORKS_KEY_PASSWORD." />
	</Target>
	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#6FB3D9" BaseSize="256,256" />
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.7" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="9.0.90" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.272-beta" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Tests\**\*.cs" />
	  <Folder Include="Views\Controls\" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
	  <Compile Remove="Data\DataService.Seeding.cs" />
	  <Compile Remove="Views\DeveloperSettingsPanel.xaml.cs" />
	  <MauiXaml Remove="Views\DeveloperSettingsPanel.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\DashboardPage.xaml.cs">
	    <DependentUpon>DashboardPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\FeedbackPage.xaml.cs">
	    <DependentUpon>FeedbackPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\MyCalendarPage.xaml.cs">
	    <DependentUpon>MyCalendarPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\SelectStudentForVisitPage.xaml.cs">
	    <DependentUpon>SelectStudentForVisitPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\StudentsListPage.xaml.cs">
	    <DependentUpon>StudentsListPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="AppShell.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\AddStudentPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\AddVisitPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\DashboardPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\EditStudentPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\FeedbackPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MyCalendarPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\SelectStudentForVisitPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\SettingsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\StudentProfilePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\StudentsListPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\StudentsMapPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\UpdateVisitPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
