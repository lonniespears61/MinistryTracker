<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:MinistryTracker.Views.Converters"
             xmlns:local="clr-namespace:MinistryTracker"
             x:Class="MinistryTracker.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Converters -->
            <conv:BoolToColorConverter x:Key="BoolToColor" />
            <conv:BoolToThicknessConverter x:Key="BoolToThickness" />
            <conv:BoolToFontAttributesConverter x:Key="BoolToFontAttrs" />

            <!-- Merged resource dictionaries (colors, styles, etc.) -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
